{
  "name": "calliopi",
  "version": "0.0.0",
  "private": true,
  "description": "A modular, local-first harness for Pi.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "workspaces": [
    "packages/*"
  ],
  "pi": {
    "extensions": [
      "./packages/core/extensions",
      "./packages/context/extensions",
      "./packages/ui/extensions",
      "./packages/calliopi-fanout/extensions"
    ],
    "skills": [
      "./packages/context/skills"
    ],
    "prompts": [
      "./packages/context/prompts"
    ],
    "themes": [
      "./packages/ui/themes"
    ]
  },
  "devDependencies": {
    "@cursor/sdk": "^1.3.1"
  },
  "scripts": {
    "check:imports": "node scripts/check-imports.ts",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run check:imports && npm run typecheck && npm test"
  }
}
