{
  "name": "calliopi",
  "version": "0.0.0",
  "private": true,
  "description": "A modular, local-first harness for Pi.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "workspaces": [
    "packages/*"
  ],
  "pi": {
    "extensions": [
      "./packages/core/extensions",
      "./packages/context/extensions",
      "./packages/ui/extensions",
      "./packages/calliopi-fanout/extensions",
      "./packages/calliopi-workflows/extensions"
    ],
    "skills": [
      "./packages/context/skills"
    ],
    "prompts": [
      "./packages/context/prompts"
    ],
    "themes": [
      "./packages/ui/themes"
    ]
  },
  "devDependencies": {
    "@cursor/sdk": "^1.3.1",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "check:imports": "node scripts/check-imports.ts",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run check:imports && npm run typecheck && npm test && npm run demo:test",
    "demo": "node demo/build.ts",
    "demo:check": "node demo/build.ts --check",
    "demo:test": "tsc -p demo && node --test demo/test/*.test.ts"
  }
}
