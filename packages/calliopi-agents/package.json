{
  "name": "@calliopi/calliopi-agents",
  "version": "0.0.0",
  "private": true,
  "description": "Subagents: a model delegates a task to a child Pi running in a multiplexer pane, with a contract, a budget and a result it reports through finish.",
  "type": "module",
  "calliopi": {
    "layer": "app"
  },
  "imports": {
    "#lib/*": "./lib/*"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p ."
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@calliopi/core": "*"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "^22",
    "typescript": "^5.9"
  }
}
