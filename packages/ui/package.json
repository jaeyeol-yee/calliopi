{
  "name": "@calliopi/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Status display, notifications, terminal UI, and themes for Calliopi.",
  "type": "module",
  "imports": {
    "#lib/*": "./lib/*"
  },
  "exports": {
    "./table": "./lib/table.ts",
    "./package.json": "./package.json"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "themes": [
      "./themes"
    ]
  },
  "scripts": {
    "postinstall": "node scripts/prepare-pty.ts",
    "test": "node --test test/*.test.ts",
    "smoke": "node scripts/smoke-picker.ts",
    "typecheck": "tsc -p ."
  },
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "dependencies": {
    "@calliopi/core": "*",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "^22",
    "typescript": "^5.9"
  }
}
