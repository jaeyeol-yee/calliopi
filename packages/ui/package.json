{
  "name": "@calliopi/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Status display, notifications, terminal UI, and themes for Calliopi.",
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "themes": [
      "./themes"
    ]
  },
  "scripts": {
    "postinstall": "node scripts/prepare-pty.mjs",
