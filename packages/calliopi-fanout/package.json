{
  "name": "@calliopi/calliopi-fanout",
  "version": "0.0.0",
  "private": true,
  "description": "Fan out Cursor Cloud Agents and track raw run status / summaries in the background (rex layer optional).",
  "type": "module",
  "imports": {
    "#extensions/*": "./extensions/*",
    "#lib/*": "./lib/*",
    "#test/*": "./test/*"
  },
  "bin": {
    "calliopi-fanout": "./bin/tracker.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "mock": "node test/mock-cursor.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@calliopi/ui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "^22",
    "typescript": "^5.9"
  },
  "peerDependencies": {
    "@cursor/sdk": ">=1.3.1",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@cursor/sdk": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
