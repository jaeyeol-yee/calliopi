{
  "name": "@calliopi/cloud-fanout",
  "version": "0.0.0",
  "private": true,
  "description": "Fan out Cursor Cloud Agents and track raw run status / summaries in the background (rex layer optional).",
  "type": "module",
  "bin": {
    "calliopi-fanout": "./bin/tracker.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "mock": "node test/mock-cursor.mjs"
  },
  "peerDependencies": {
    "@cursor/sdk": ">=1.3.1",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@cursor/sdk": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
