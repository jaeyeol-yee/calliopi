{
  "name": "@calliopi/core",
  "version": "0.0.0",
  "private": true,
  "description": "Execution primitives shared by Calliopi layers: fzf selection, program runners, workflows, PR lookup, subscription usage, terminal multiplexers, subagent records. No dependencies.",
  "type": "module",
  "calliopi": {
    "layer": "core"
  },
  "imports": {
    "#lib/*": "./lib/*"
  },
  "exports": {
    "./fzf": "./lib/fzf.ts",
    "./workflow": "./lib/workflow.ts",
    "./types": "./lib/types.ts",
    "./tty": "./lib/tty.ts",
    "./capture": "./lib/capture.ts",
    "./pr-lookup": "./lib/pr-lookup.ts",
    "./usage": "./lib/usage/index.ts",
    "./multiplexer": "./lib/multiplexer/index.ts",
    "./agents": "./lib/agents/index.ts",
    "./package.json": "./package.json"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p ."
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.9"
  }
}
