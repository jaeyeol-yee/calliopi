{
  "name": "@calliopi/core",
  "version": "0.0.0",
  "private": true,
  "description": "Execution primitives and primitive tools shared by Calliopi layers: fzf selection, program runners, workflows, PR lookup, subscription usage, terminal multiplexers, subagent records, web_fetch. No runtime dependencies besides Pi.",
  "type": "module",
  "calliopi": {
    "layer": "core"
  },
  "imports": {
    "#lib/*": "./lib/*",
    "#extensions/*": "./extensions/*"
  },
  "exports": {
    "./fzf": "./lib/fzf.ts",
    "./workflow": "./lib/workflow.ts",
    "./types": "./lib/types.ts",
    "./tty": "./lib/tty.ts",
    "./capture": "./lib/capture.ts",
    "./pr-lookup": "./lib/pr-lookup.ts",
    "./usage": "./lib/usage/index.ts",
    "./multiplexer": "./lib/multiplexer/index.ts",
    "./agents": "./lib/agents/index.ts",
    "./notes": "./lib/notes.ts",
    "./smells": "./lib/smells.ts",
    "./debrief": "./lib/debrief.ts",
    "./web": "./lib/web/index.ts",
    "./package.json": "./package.json"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p ."
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "^22",
    "typescript": "^5.9"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
